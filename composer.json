{
    "name": "gggeek/yet-another-docker-socket-proxy",
    "description": "A WAF to filter access to the Docker Daemon API",
    "license": "GPL-2.0",
    "homepage": "https://gggeek.github.io/docker-proxy-filter-php/",
    "keywords": [ "docker", "proxy", "security", "api", "firewall" ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-json": "*",
        "gggeek/yet-another-waf-core": "dev-main",
        "laminas/laminas-httphandlerrunner": "^2.13.0",
        "nyholm/psr7-server": "^1.1.0"
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-mbstring": "*",
        "phpunit/phpunit": "^11",
        "phpunit/phpunit-selenium": "*",
        "yoast/phpunit-polyfills": "*"
    },
    "scripts": {
        "setup-git-hooks": "if ln -s -f $(pwd)/.githooks/pre-push.sh .git/hooks/pre-push; then echo hooks installed; else echo fail; fi"
    },
    "autoload": {
        "psr-4": {"YADSP\\": "src/"}
    }
}
